{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "nexus-expediente/motor": ["./src/motor-entrada.ts"], "nexus-expediente": ["./src/index.ts"] }
  },
  "include": ["src", "site", "test/tipos"]
}
